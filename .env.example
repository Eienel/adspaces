# ---------- shared ----------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/adspaces
REDIS_URL=                      # Upstash REST URL (optional in dev)
REDIS_TOKEN=

# Image storage shared by web + worker (local dev). On Vercel set BLOB_READ_WRITE_TOKEN instead.
UPLOAD_DIR=/tmp/adspaces-uploads
BLOB_READ_WRITE_TOKEN=

# ---------- $0 dev mode (ADR-0013) ----------
DEV_LOGIN=1                     # fake X login + dev buttons. Refused in production unless ALLOW_DEV_LOGIN=1
BANNER_SOURCE=dev               # dev | owned (creator's own X token, cheapest) | app (X_BEARER_TOKEN)
PAYMENTS_PROVIDER=dev           # dev (simulated) | solana (real custodial escrow)
TOKEN_ENC_KEY=                  # `openssl rand -base64 32`, encrypts X refresh tokens (needed for BANNER_SOURCE=owned)

# ---------- web (apps/web) ----------
AUTH_SECRET=                    # `openssl rand -base64 32`
AUTH_TWITTER_ID=                # X developer app OAuth 2.0 client ID
AUTH_TWITTER_SECRET=            # X developer app OAuth 2.0 client secret
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU   # devnet USDC
NEXT_PUBLIC_ESCROW_WALLET=      # public key of the escrow deposit wallet
PLATFORM_FEE_BPS=1000           # 10% placeholder — owner to decide

# ---------- worker (apps/worker) — NEVER expose to web ----------
X_BEARER_TOKEN=                 # optional: app bearer token (BANNER_SOURCE=app, fallback for owned, weekly metrics sync)
SOLANA_RPC_URL=https://api.devnet.solana.com
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
ESCROW_WALLET_SECRET=           # base58 secret key of escrow wallet
TREASURY_WALLET=                # Squads multisig vault address
VERIFY_CHECKS_PER_DAY=2
METRICS_SYNC_DAYS=7
