    "bs58": "6.0.0",
    "drizzle-orm": "0.45.4",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
